# Server-only secrets: set these in Vercel Project Settings > Environment Variables.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Safe to use in the admin browser. Set matching values in src/scripts/config.js.
# Do not put the service-role key in any frontend file.
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
